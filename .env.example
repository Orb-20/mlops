# Copy to .env and fill in. Never commit .env.

# Optional: enables LIVE YouTube analysis. Without it, the app runs on DEMO DATA.
YOUTUBE_API_KEY=

# Local (no Docker): SQLite fallback. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./local.db
# DATABASE_URL=postgresql+psycopg://mlops:mlops@localhost:5432/mlops

# Local (no Docker): file-backed MLflow. Docker Compose overrides with http://mlflow:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

ENVIRONMENT=local
API_URL=http://localhost:8000
